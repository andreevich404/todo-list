{
  "name": "todo-list",
  "version": "1.0.0",
  "description": "To-Do на Vue 3 и TypeScript: Pinia, Vue Router, ESLint и Prettier (лабораторная №9)",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "type-check": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run type-check && npm run lint && npm run format:check"
  },
  "author": "Tolkachev Ivan Andreevich",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "sass": "^1.105.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "type": "module"
}
